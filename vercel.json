{
  "rewrites": [{ "source": "/((?!sitemap\\.xml|favicon\\.svg|robots\\.txt).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/:file*.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/:file*.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*\\.(jpg|jpeg|png|webp|svg|gif|mp4|woff2|ttf))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
